<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0"><dict>
  <key>Label</key><string>com.commandboard.command-board-satellite</string>
  <key>ProgramArguments</key><array><string>__HOME__/Documents/GitHub/command-board-kit/bin/satellite-sync</string></array>
  <!-- Every day 06:40 and 16:40 local: twenty minutes before the hub run reads the bundle. -->
  <key>StartCalendarInterval</key><array>
    <dict><key>Hour</key><integer>6</integer><key>Minute</key><integer>40</integer></dict>
    <dict><key>Hour</key><integer>16</integer><key>Minute</key><integer>40</integer></dict>
  </array>
  <!-- Pinned to US Eastern so stamps and the AM/PM decision never follow a travelling Mac's clock. -->
  <key>EnvironmentVariables</key><dict><key>TZ</key><string>America/New_York</string></dict>
  <key>RunAtLoad</key><false/>
  <key>StandardOutPath</key><string>__HOME__/Library/Logs/command-board/satellite.out.log</string>
  <key>StandardErrorPath</key><string>__HOME__/Library/Logs/command-board/satellite.err.log</string>
</dict></plist>
